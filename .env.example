# Optional API keys read by src/models/router.py and experiments/compa_ratio_drift/drift.py.
# Model names live in src/models/router.py. If no key is set, the advisor runs
# deterministically offline with zero network calls.

OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional local Ollama server (native endpoint, no trailing /v1)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=false

# Optional: name another model when a provider has retired or renamed a default one.
# The default names are in src/models/router.py. Check the result with
# python3 -m src.models.router --status, then python3 -m src.evaluation.live_writer --provider auto.
# The recorded run used GEMINI_API_KEY with ADVISOR_REASONING_MODEL=gemini-3.5-flash-lite.
# ADVISOR_REASONING_MODEL=
# ADVISOR_FAST_MODEL=
