# OpenRouter API configuration (recommended for multi-model routing)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Google AI Studio API key (for direct Gemini Flash / Pro access)
GEMINI_API_KEY=your_gemini_api_key_here

# Two-Tier Model Routing Defaults
FAST_TOOL_MODEL=google/gemini-2.5-flash
REASONING_SYNTHESIS_MODEL=google/gemini-2.5-pro

# Optional Local Ollama Fallback
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:12b
